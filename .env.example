# ── Sitio público ───────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Maestro"

# ── Sanity ──────────────────────────────────────
# Crea un proyecto en https://sanity.io/manage y copia el ID.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Token de lectura (Sanity → API → Tokens, permiso "Viewer").
# Necesario para previews y borradores; opcional en producción si todo es público.
SANITY_API_READ_TOKEN=

# Token de escritura (Sanity → API → Tokens, permiso "Editor").
# REQUERIDO para persistir órdenes y decrementar stock automáticamente.
SANITY_API_WRITE_TOKEN=

# Secreto que valida los webhooks de Sanity al endpoint /api/revalidate.
# Genera uno con: openssl rand -base64 32
SANITY_REVALIDATE_SECRET=

# ── Admin (panel /admin) ────────────────────────
# Contraseña que pide el formulario en /admin/login.
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión. Genera con: openssl rand -base64 32
# Rotarlo invalida todas las sesiones admin activas.
ADMIN_SESSION_SECRET=

# ── Mercado Pago ────────────────────────────────
# Crea una app en https://www.mercadopago.com.mx/developers/panel
# Para desarrollo usa el Access Token de TEST; en producción el de PROD.
MERCADOPAGO_ACCESS_TOKEN=
# Secreto del webhook (Mercado Pago → Webhooks → Configuración)
MERCADOPAGO_WEBHOOK_SECRET=
# Si tu URL pública difiere de NEXT_PUBLIC_SITE_URL, configura aquí.
# MERCADOPAGO_BACK_URL_BASE=
